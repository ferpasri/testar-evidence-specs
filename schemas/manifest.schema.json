{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "TESTAR evidence manifest",
    "type": "object",
    "properties": {
        "schema_version": {
            "const": 3
        },
        "evidence_id": {
            "type": "string",
            "pattern": "^(?=.*\\S)[^\\u0000-\\u001f\\u007f]+$"
        }
    },
    "required": [
        "schema_version",
        "evidence_id"
    ],
    "additionalProperties": false
}
